# =============================================================================
# Outreach Portal — Backend Production Environment Template (.env)
# Rename this file to .env on production and configure values below.
# =============================================================================

# Application Environment: 'production' for live deployment, 'development' for debugging
CI_ENVIRONMENT = production

# Application Base URL (e.g. https://vdsai.com/outreach_portal/backend/public/)
app.baseURL = 'https://vdsai.com/outreach_portal/backend/public/'

# -----------------------------------------------------------------------------
# Database Configuration (MySQL / MariaDB)
# -----------------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = pitch_portal
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# -----------------------------------------------------------------------------
# Portal Security & Authentication
# -----------------------------------------------------------------------------
portal.adminUser = admin
portal.adminPass = Admin@123
portal.tokenSecret = 'ccims-pitch-portal-secret-key-2026-production-secure'
portal.corsOrigin = '*'

# -----------------------------------------------------------------------------
# AI Pipeline & Telephony Integration
# -----------------------------------------------------------------------------
pipeline.python = python3
pipeline.webhookSecret = ''

