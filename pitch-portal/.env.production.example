# =============================================================================
# backend/.env.production.example
# Copy this to .env on the production server and fill in actual values.
# Backend path: https://vdsai.com/outreach_portal/backend/
# =============================================================================

CI_ENVIRONMENT = production
app.baseURL = 'https://vdsai.com/outreach_portal/backend/public/'

database.default.hostname = 127.0.0.1
database.default.database = pitch_portal
database.default.username = YOUR_DB_USER
database.default.password = YOUR_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.port     = 3306

# Portal login credentials
portal.adminUser = admin
portal.adminPass = CHANGE_THIS_STRONG_PASSWORD
portal.tokenSecret = 'CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING'

# CORS: allow the production frontend origin
portal.corsOrigin = 'https://vdsai.com'

# Python pipeline (absolute path on server)
pipeline.python = /home/vdsai/pitch-portal/ai_pipeline/venv/bin/python3
pipeline.webhookSecret = CHANGE_THIS_WEBHOOK_SECRET

# Optional: Override Bolna API key via env (highest priority, overrides DB settings)
# bolna.apiKey   = bn-your-key-here
# bolna.baseUrl  = https://api.bolna.ai

